---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="logo-badge">
        <img src="/logo.jpeg" alt="Synapse" width="100" height="50" />
      </span>
      <p class="tagline">Nós implementamos tecnologia para empresas crescerem.</p>
    </div>

    <nav class="footer-links" aria-label="Links do rodapé">
      <h3 class="footer-label">Navegação</h3>
      <a href="/servicos">Serviços</a>
      <a href="/processo">Processo</a>
      <a href="/sobre">Sobre</a>
      <a href="/portfolio">Portfólio</a>
      <a href="/contato">Contato</a>
    </nav>

    <div class="footer-contact">
      <h3 class="footer-label">Contato</h3>
      <a href="https://wa.me/5519984570405">(19) 98457-0405</a>
      <a href="mailto:iago.venancio.cruz@gmail.com">iago.venancio.cruz@gmail.com</a>
      <span>Campinas, SP — Brasil</span>
    </div>
  </div>

  <div class="container">
    <p class="copyright">© {year} Synapse. Todos os direitos reservados.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg-dark);
    color: var(--color-text-on-dark);
    padding-block: var(--space-12) var(--space-8);
    margin-top: var(--space-16);
  }

  .footer-inner {
    display: grid;
    gap: var(--space-8);
    padding-bottom: var(--space-6);
  }

  @media (min-width: 1024px) {
    .footer-inner {
      grid-template-columns: 1.2fr 1fr 1fr;
    }
  }

  .logo-badge {
    display: inline-flex;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    margin-bottom: var(--space-3);
  }

  .footer-brand img {
    height: 28px;
    width: auto;
    display: block;
  }

  .tagline {
    color: var(--color-text-on-dark-secondary);
    font-size: var(--text-sm);
    max-width: 32ch;
  }

  .footer-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: var(--space-3);
  }

  .footer-links,
  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .footer-links a,
  .footer-contact a,
  .footer-contact span {
    color: var(--color-text-on-dark-secondary);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer-links a:hover,
  .footer-contact a:hover {
    color: var(--color-text-on-dark);
  }

  .copyright {
    border-top: 1px solid var(--color-border-dark);
    padding-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-text-on-dark-secondary);
  }
</style>

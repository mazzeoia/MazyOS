---
import { services } from "../../lib/servicos";

// Trilho horizontal preso ao scroll no desktop; no mobile vira carrossel com
// snap. A grade 4x2 de cards quadrados era a saída óbvia — e é exatamente a
// "seção empilhada igual às outras" que o projeto não pode ter.
---

<section class="svc" data-hscroll id="servicos">
  <div class="svc-stage">
    <div class="shell svc-head">
      <div>
        <p class="label" data-anim="fade">
          <span class="svc-tick"></span>
          O que a Nescau faz
        </p>
        <h2 class="svc-title display-lg" data-split>Oito frentes, um interlocutor</h2>
      </div>

      <p class="svc-hint label">
        <span class="svc-hint-arrow">→</span>
        Role para o lado
      </p>
    </div>

    <div class="svc-rail">
      <div class="svc-track" data-hscroll-track>
        {services.map((s) => (
          <article class="card" data-tilt="5">
            <div class="card-media">
              <img src={s.image} alt="" width="900" height="1200" loading="lazy" decoding="async" />
              <div class="card-veil"></div>
              <span class="card-n index">{s.n}</span>
            </div>

            <div class="card-body">
              <h3 class="card-title">{s.title}</h3>
              <p class="card-short">{s.short}</p>
              <p class="card-text">{s.body}</p>

              <ul class="card-list">
                {s.bullets.map((b) => (
                  <li>
                    <span class="card-bullet"></span>
                    {b}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}

        <a class="card card-end" href="/servicos">
          <span class="card-end-label label">Tudo em detalhe</span>
          <span class="card-end-title">Ver todos os serviços</span>
          <span class="card-end-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .svc {
    position: relative;
    background: var(--void);
    border-top: 1px solid var(--rule);
  }

  /* A dobra é presa em tela cheia enquanto o trilho corre: título e cards
     precisam caber JUNTOS na viewport, então o respiro aqui é medido em vh,
     não no --bay padrão das seções que rolam normalmente. */
  .svc-stage {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(28px, 4.5vh, 56px);
    padding-block: clamp(72px, 9vh, 120px);
    overflow: hidden;
  }

  .svc-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-5);
    flex: none;
  }

  .svc-tick {
    display: inline-block;
    width: 26px;
    height: 1px;
    background: var(--amber);
    margin-right: 0.9em;
    vertical-align: middle;
  }

  .svc-title {
    margin-top: var(--s-4);
    max-width: 7.1em;
    font-size: var(--d-md);
  }

  .svc-hint {
    display: none;
    align-items: center;
    gap: 0.7em;
    padding-bottom: 0.6rem;
    flex: none;
  }

  .svc-hint-arrow {
    color: var(--amber);
    animation: nudge 2s var(--ease) infinite;
  }

  @keyframes nudge {
    0%,
    100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(5px);
    }
  }

  /* --- trilho ------------------------------------------------------------ */
  .svc-rail {
    overflow: visible;
    flex: 1;
    min-height: 0;
    display: flex;
  }

  .svc-track {
    display: flex;
    align-items: stretch;
    gap: var(--s-5);
    padding-inline: var(--gut);
    width: max-content;
    will-change: transform;
  }

  /* --- card -------------------------------------------------------------- */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: min(78vw, 23rem);
    max-height: 620px;
    flex: none;
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    overflow: hidden;
    background: linear-gradient(180deg, var(--raised-2) 0%, var(--raised) 100%);
    transform-style: preserve-3d;
    transition:
      border-color var(--dur-2) var(--ease),
      box-shadow var(--dur-3) var(--ease);
    will-change: transform;
  }

  /* Brilho que segue o ponteiro pela superfície (posição escrita pelo
     motion.ts em --sheen-x/y). Sem ele o tilt 3D parece só uma div torta. */
  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      420px circle at var(--sheen-x, 50%) var(--sheen-y, 0%),
      rgba(255, 197, 49, 0.13),
      transparent 62%
    );
    transition: opacity var(--dur-3) var(--ease);
  }

  .card:hover {
    border-color: var(--rule-warm);
    box-shadow: var(--glow-md);
  }

  .card:hover::after {
    opacity: 1;
  }

  .card-media {
    position: relative;
    flex: 0 0 38%;
    min-height: 130px;
    overflow: hidden;
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }

  .card:hover .card-media img {
    transform: scale(1.06);
  }

  .card-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 30%, var(--raised-2) 100%);
  }

  .card-n {
    position: absolute;
    top: var(--s-4);
    left: var(--s-4);
    color: var(--amber);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-5);
    flex: 1;
    min-height: 0;
  }

  .card-title {
    font-size: clamp(1.65rem, 3vw, 2.1rem);
  }

  .card-short {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--amber);
  }

  .card-text {
    font-size: var(--t-base);
    color: var(--ink-soft);
    flex: 1;
  }

  .card-list {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
  }

  .card-list li {
    display: flex;
    align-items: center;
    gap: 0.7em;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }

  .card-bullet {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--flame);
    flex: none;
  }

  /* --- card final: leva pra página de serviços --------------------------- */
  .card-end {
    width: min(60vw, 18rem);
    justify-content: center;
    align-items: flex-start;
    gap: var(--s-4);
    padding: var(--s-6);
    background: var(--beam-soft);
    color: var(--on-light);
    border-color: transparent;
  }

  .card-end-title {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 0.95;
  }

  .card-end-label {
    color: rgba(5, 5, 5, 0.62);
  }

  .card-end-arrow {
    font-size: 1.6rem;
    transition: transform var(--dur-2) var(--ease);
  }

  .card-end:hover .card-end-arrow {
    transform: translateX(8px);
  }

  /* --- mobile: carrossel com snap --------------------------------------- */
  @media (max-width: 899px) {
    .svc-rail {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .svc-rail::-webkit-scrollbar {
      display: none;
    }

    .card {
      scroll-snap-align: start;
    }
  }

  @media (min-width: 900px) {
    .svc-hint {
      display: flex;
    }
  }

  /* Sem movimento não existe pin, e o trilho ficaria cortado pelo overflow
     do palco — cards 4 em diante inalcançáveis. Aqui ele volta a ser um
     carrossel comum, com barra de rolagem nativa. */
  @media (min-width: 900px) and (prefers-reduced-motion: reduce) {
    .svc-stage {
      min-height: 0;
    }

    .svc-rail {
      overflow-x: auto;
    }

    .svc-hint {
      display: none;
    }
  }
</style>
